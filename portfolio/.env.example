# The URL where the Payload CMS API is served
PUBLIC_CMS_URL=http://localhost:3000
CMS_URL=http://localhost:3000

# The public URL where the static portfolio is hosted
SITE_URL=
PUBLIC_SITE_URL=

# Optional API key generated from the Payload CMS ServiceAccount collection
# Format: <apiKey> or "service-accounts API-Key <apiKey>"
PAYLOAD_API_KEY=
