# Database and Secrets
DATABASE_URI=postgres://postgres:<password>@127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Vercel Blob Storage Token (Required for production file uploads)
BLOB_READ_WRITE_TOKEN=YOUR_VERCEL_BLOB_TOKEN

# Deployment URLs
PAYLOAD_PUBLIC_SERVER_URL=
SERVER_URL=

# Allowed Frontend Origins for CORS / CSRF (comma-separated or single URL)
FRONTEND_URL=
PORTFOLIO_URL=
CORS_ORIGINS=
CSRF_ORIGINS=

# Optional custom image domains for Next.js image optimization
IMAGE_DOMAINS=
